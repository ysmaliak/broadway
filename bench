import json
import os
import socket
import sys

def clean(text):
    """A page chooses its title: nothing in it may move the terminal's cursor,
    change its colours, or turn the line around."""
    import re
    return re.sub(r"[\x00-\x1f\x7f\u200e\u200f\u202a-\u202e\u2066-\u2069]", "", str(text or ""))

def folder(world):
    name = f"Broadway ({world})" if world else "Broadway"
    return os.path.expanduser(f"~/Library/Application Support/{name}")

def ask(path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            sys.exit("Broadway isn't listening — is it open, with Settings › General › "
                     "“Let a script drive Broadway” on?")
        s.sendall((json.dumps(request) + "\n").encode())
        chunks = []
        while True:
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            chunks.append(chunk)
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line or b"{}")

def main(argv):
    world = "test" if "--test" in argv else None
    if "--world" in argv:
        at = argv.index("--world")
        if at + 1 >= len(argv): sys.exit("usage: bench --world NAME COMMAND …")
        world = "".join(c for c in argv[at + 1].lower() if c.isascii() and (c.isalnum() or c == "-"))
        if world in ("", "1"): world = "test"
        argv = argv[:at] + argv[at + 2:]
    window = None
    if "--window" in argv:
        at = argv.index("--window")
        if at + 1 >= len(argv): sys.exit("usage: bench --window N COMMAND …")
        window = int(argv[at + 1])
        argv = argv[:at] + argv[at + 2:]
    yes = "--yes" in argv
    argv = [a for a in argv if a not in ("--test", "--yes")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    verb, args = argv[0], argv[1:]
    request = {"do": verb}
    if window is not None: request["window"] = window
    if verb == "open":
        if len(args) not in (1, 2) or args[1:] not in ([], ["private"]): sys.exit("usage: bench open URL [private]")
        request["url"] = args[0]
        if args[1:] == ["private"]: request["private"] = True
    elif verb == "go":
        if len(args) != 2: sys.exit("usage: bench go ID URL")
        request["id"], request["url"] = args
    elif verb in ("wait",):
        if not args: sys.exit("usage: bench wait ID [SECONDS]")
        request["id"] = args[0]
        if len(args) > 1: request["seconds"] = float(args[1])
    elif verb in ("text", "close", "sleep", "select", "visible", "adopt"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
    elif verb == "translate":
        if len(args) not in (1, 2, 3): sys.exit("usage: bench translate ID [LANG|original|state|toggle|always LANG|never LANG]")
        request["id"] = args[0]
        if len(args) >= 2:
            if args[1] in ("original", "state", "toggle", "always", "never"): request["action"] = args[1]
            else: request["lang"] = args[1]
        if len(args) == 3: request["lang"] = args[2]
    elif verb == "eval":
        if len(args) not in (2, 3) or (len(args) == 3 and args[2] != "search"): sys.exit("usage: bench eval ID JS [search]")
        request["id"], request["js"] = args[0], args[1]
        if len(args) == 3: request["world"] = "search"
    elif verb in ("click", "submit", "tap"):
        mods = [a for a in args[2:] if a in ("shift", "cmd", "opt")] if verb == "tap" else []
        if len(args) != 2 + len(mods): sys.exit(f"usage: bench {verb} ID SELECTOR" + (" [shift] [cmd] [opt]" if verb == "tap" else ""))
        request["id"], request["selector"] = args[:2]
        if mods: request["mods"] = mods
    elif verb == "type":
        if len(args) != 3: sys.exit("usage: bench type ID SELECTOR TEXT")
        request["id"], request["selector"], request["text"] = args
    elif verb == "shot":
        if not args: sys.exit("usage: bench shot ID [PATH] [WIDTH]")
        request["id"] = args[0]
        if len(args) > 1: request["path"] = os.path.abspath(args[1])
        if len(args) > 2: request["width"] = float(args[2])
    elif verb == "pdf":
        if len(args) != 1: sys.exit("usage: bench pdf PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "network":
        if len(args) > 1 or (args and args[0] not in ("away", "back", "state")): sys.exit("usage: bench network [away|back|state]")
        request["action"] = args[0] if args else "state"
    elif verb == "sitefiles":
        if not args or args[0] not in ("state", "allow", "deny", "public", "local", "forget"): args = ["state"] + args
        request["action"] = args[0]
        if args[0] == "public":
            if len(args) != 2: sys.exit("usage: bench sitefiles public HOST")
            request["host"] = args[1]
        elif args[0] in ("allow", "deny") and len(args) > 1:
            request["id"] = args[1]
    elif verb == "dock":
        if len(args) > 1 or (args and args[0] not in ("state", "tile", "leave")): sys.exit("usage: bench dock [state|tile|leave]")
        request["action"] = args[0] if args else "state"
    elif verb == "sitesearch":
        request["action"] = args[0] if args else "state"
        if len(args) == 3 and args[0] == "learn":
            request["page"], request["description"] = args[1], args[2]
    elif verb == "ui":
        if len(args) != 2: sys.exit("usage: bench ui KEY VALUE")
        key, value = args
        if key == "side" and value not in ("left", "right"): sys.exit("usage: bench ui side left|right")
        request[key] = value if key in ("look", "edittab", "peeklink", "import", "side", "pages120", "settingspage", "link", "announce") else value in ("on", "true", "1", "yes")
    elif verb in ("ext-add", "ext-press", "ext-remove", "ext-reload"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
        request["yes"] = yes
    elif verb == "capture":
        pass
    elif verb == "sidepanel":
        request["action"] = args[0] if args else "state"
        if args and args[0] == "eval":
            if len(args) != 2: sys.exit("usage: bench sidepanel eval JS")
            request["js"] = args[1]
    elif verb == "capture-stop":
        if len(args) != 1: sys.exit("usage: bench capture-stop ID")
        request["id"] = args[0]
    elif verb == "ext-enable":
        if len(args) != 2: sys.exit("usage: bench ext-enable ID on|off")
        request["id"] = args[0]
        request["on"] = args[1] in ("on", "true", "1", "yes")
    elif verb == "ext-private":
        if len(args) != 2 or args[1] not in ("on", "off"): sys.exit("usage: bench ext-private ID on|off")
        request["id"] = args[0]
        request["on"] = args[1] == "on"
    elif verb == "ext-pin":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench ext-pin ID [on|off]")
        request["id"] = args[0]
        request["on"] = (args[1] if len(args) > 1 else "on") in ("on", "true", "1", "yes")
    elif verb == "ext-answer":
        if len(args) != 1 or args[0] not in ("yes", "no", "ask"): sys.exit("usage: bench ext-answer yes|no|ask")
        request["answer"] = args[0]
    elif verb == "ext-shot":
        if len(args) != 2: sys.exit("usage: bench ext-shot ID PATH")
        request["id"] = args[0]
        request["path"] = os.path.abspath(args[1])
    elif verb == "ext-menu":
        if len(args) != 1: sys.exit("usage: bench ext-menu PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "ext-folder":
        if len(args) != 1: sys.exit("usage: bench ext-folder PATH")
        request["path"] = os.path.abspath(args[0])
        request["yes"] = yes
    elif verb == "ext-popup":
        if len(args) != 2: sys.exit("usage: bench ext-popup ID JS")
        request["id"], request["js"] = args
    elif verb == "ext-page":
        if not args: sys.exit("usage: bench ext-page ID [PATH]")
        request["id"] = args[0]
        request["path"] = args[1] if len(args) > 1 else ""
    elif verb == "press":
        if len(args) < 2: sys.exit("usage: bench press KEYCODE CHARS [cmd] [shift] [ctrl] [opt]")
        request["code"], request["chars"], request["mods"] = int(args[0]), args[1], args[2:]
    elif verb == "textcheck":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench textcheck ID [quotes|dashes|replacement]")
        request["id"] = args[0]
        if len(args) == 2: request["toggle"] = args[1]
    elif verb == "key":
        if len(args) != 2: sys.exit("usage: bench key ID TEXT")
        request["id"], request["text"] = args
    elif verb == "resize":
        if len(args) not in (2, 3): sys.exit("usage: bench resize WIDTH HEIGHT [STEPS]")
        request["width"], request["height"] = float(args[0]), float(args[1])
        if len(args) == 3: request["steps"] = int(args[2])
    elif verb == "consent":
        if len(args) > 1 or (args and args[0] not in ("grant", "revoke")): sys.exit("usage: bench consent [grant|revoke]")
        if args: request["action"] = args[0]
    elif verb == "fold":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench fold PATH [WIDTH]")
        request["path"] = os.path.abspath(args[0])
        if len(args) == 2: request["width"] = float(args[1])
    elif verb == "site":
